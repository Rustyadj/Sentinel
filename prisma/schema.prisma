// ============================================================================
// Learning Core — see docs/LEARNING_CORE_ON_NEURAL_ENGINE.md
//
// Extends the Neural Engine above (Experience/Outcome/Evaluation/
// LearningCandidate/Skill/AgentCompetency), does not duplicate it. Every
// model below is genuinely net-new — confirmed absent from `main` by direct
// inspection before writing this. agentId fields deliberately stay plain
// String (no FK relation), matching the existing Experience/LearningCandidate
// convention — Neural Engine never hard-relates to Agent either.
// ============================================================================

// Fine-grained execution event stream — distinct from Experience (one row
// per whole task) and from KnowledgeEvent (graph-object mutations only).
model LearningEvent {
  id            String   @id @default(cuid())
  eventType     String
  sourceType    String?
  sourceId      String?
  agentId       String?
  userId        String?
  workspaceId   String?
  projectId     String?
  chatRoomId    String?
  messageId     String?
  workflowId    String?
  taskId        String?
  traceId       String? // Experience.id, when this event belongs to one
  parentTraceId String?
  severity      String   @default("info") // debug, info, warning, error, critical
  payload       Json     @default("{}")
  redactedKeys  String[] @default([]) // keys stripped from payload before persistence — audit transparency, not a security boundary itself
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([traceId])
  @@index([agentId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
  @@map("learning_events")
}

model CuriosityEvent {
  id                  String    @id @default(cuid())
  traceId             String? // Experience.id
  agentId             String
  workspaceId         String?
  projectId           String?
  triggerType         String
  question            String?
  reason              String?
  confidenceBefore    Float?
  ambiguityScore      Float?
  noveltyScore        Float?
  conflictScore       Float?
  businessImpactScore Float?
  urgencyScore        Float?
  curiosityScore      Float
  asked               Boolean   @default(false)
  answered            Boolean   @default(false)
  answerSummary       String?
  outcome             String?
  createdAt           DateTime  @default(now())
  answeredAt          DateTime?

  // --- Curiosity Engine upgrade (additive; see docs/LEARNING_CORE_EVOLUTION.md)
  // Evidence-driven uncertainty dimensions — a finer-grained decomposition
  // than ambiguityScore/conflictScore above, which stay unchanged and in use.
  intentUncertainty            Float?
  knowledgeUncertainty         Float?
  preferenceUncertainty        Float?
  goalUncertainty              Float?
  environmentUncertainty       Float?
  riskUncertainty              Float?
  contradictionUncertainty     Float?
  // Expected-value-of-clarification vs. expected-cost-of-interruption — the
  // computational form of "should the agent consider asking" rather than
  // asking on every uncertainty signal.
  expectedValueOfClarification Float?
  expectedCostOfInterruption   Float?
  // Question quality evaluation — scored independently of whether the
  // question was ultimately asked, so the engine can learn when NOT to ask.
  questionNecessity            Float?
  questionSpecificity          Float?
  questionInformationGain      Float?
  questionUserBurden           Float?
  questionRedundancy           Float?
  questionQualityScore         Float?

  @@index([agentId, createdAt])
  @@index([traceId])
  @@map("learning_curiosity_events")
}

model Reflection {
  id                   String   @id @default(cuid())
  traceId              String? // Experience.id
  agentId              String
  workspaceId          String?
  projectId            String?
  reflectionType       String // automatic, failure, success, user_feedback, scheduled_replay, manual
  summary              String
  whatWorked           String?
  whatFailed           String?
  unexpectedResults    String?
  incorrectAssumptions String?
  missingInformation   String?
  reusableLesson       String?
  suggestedImprovement String?
  shouldCreateSkill    Boolean  @default(false)
  shouldAskNextTime    Boolean  @default(false)
  confidence           Float?
  status               String   @default("open") // open, actioned, dismissed
  createdAt            DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([traceId])
  @@map("learning_reflections")
}

// Evidence toward a canonical `Memory` of type "preference" — the preference
// itself stays a Memory row (per project convention); this table is the
// audit trail of why its confidence is what it is.
model UserPreferenceEvidence {
  id                 String    @id @default(cuid())
  memoryId           String
  userId             String?
  agentId            String?
  workspaceId        String?
  sourceType         String
  sourceId           String?
  evidence           String
  evidenceWeight     Float     @default(1)
  supportsPreference Boolean   @default(true)
  observedAt         DateTime  @default(now())
  expiresAt          DateTime?
  metadata           Json      @default("{}")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@map("learning_preference_evidence")
}

model GoalAlignmentCheck {
