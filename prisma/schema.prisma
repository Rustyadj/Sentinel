model LearningGoal {
  id              String    @id @default(cuid())
  knowledgeGapId  String?
  agentId         String?
  workspaceId     String?
  title           String
  objective       String
  successCriteria Json      @default("[]")
  priority        String    @default("medium")
  status          String    @default("proposed") // proposed, approved, active, completed, dismissed
  approved        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  knowledgeGap KnowledgeGap? @relation(fields: [knowledgeGapId], references: [id], onDelete: SetNull)

  @@index([knowledgeGapId])
  @@map("learning_goals")
}

model ExperimentRun {
  id             String   @id @default(cuid())
  candidateId    String
  traceId        String? // Experience.id
  variant        String // baseline, candidate, control, shadow
  inputSnapshot  Json     @default("{}")
  outputSnapshot Json     @default("{}")
  metrics        Json     @default("{}")
  errors         Json     @default("[]")
  passed         Boolean?
  createdAt      DateTime @default(now())

  candidate LearningCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("learning_experiment_runs")
}

model BenchmarkDefinition {
  id            String   @id @default(cuid())
  name          String
  description   String?
  category      String
  workspaceId   String?
  inputDataset  Json     @default("[]")
  scoringMethod String
  weights       Json     @default("{}")
  thresholds    Json     @default("{}")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  results BenchmarkResult[]

  @@index([category])
  @@map("learning_benchmark_definitions")
}

model BenchmarkResult {
  id                   String   @id @default(cuid())
  benchmarkId          String
  candidateId          String?
  agentId              String?
  version              String?
  accuracy             Float?
  latency              Float?
  cost                 Float?
  completionRate       Float?
  toolEfficiency       Float?
  memoryQuality        Float?
  retrievalQuality     Float?
  clarificationQuality Float?
  userAcceptance       Float?
  hallucinationRate    Float?
  safetyViolations     Int      @default(0)
  overallScore         Float?
  rawMetrics           Json     @default("{}")
  createdAt            DateTime @default(now())

  benchmark BenchmarkDefinition @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  candidate LearningCandidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([benchmarkId])
  @@index([candidateId])
  @@map("learning_benchmark_results")
}

// Event-sourced log feeding AgentCompetency — that table is a current-state
// snapshot (score/evidenceCount/successRate); this is the history of deltas
// that produced it, which AgentCompetency alone can't reconstruct.
model TrustEvent {
  id          String   @id @default(cuid())
  agentId     String
  domain      String?
  eventType   String
  delta       Float
  reason      String
  traceId     String? // Experience.id
  candidateId String?
  createdAt   DateTime @default(now())

  candidate LearningCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@map("learning_trust_events")
}

model FeatureFlag {
  id                  String    @id @default(cuid())
  key                 String    @unique
  name                String
  description         String?
  scopeType           String    @default("global") // global, organization, workspace, project, user, agent
  scopeId             String?
  enabled             Boolean   @default(false)
  rolloutPercentage   Int       @default(0)
  variant             String?
  config              Json      @default("{}")
  riskTier            String    @default("low")
  // Rollout scope and learning provenance are separate concerns. `scopeId`
  // remains the tenant/user/agent targeting key; this nullable relation lets
  // automatic rollback find and disable every flag deploying a candidate.
  learningCandidateId String?
  // Activation/expiry — additive (PR #21 audit finding: the rollout spec
  // called for these but the schema had nowhere to put them). A flag past
  // its expiresAt evaluates to disabled regardless of `enabled`/rollout —
  // see evaluateFlag() in feature-flags.ts.
  activatedAt         DateTime?
  expiresAt           DateTime?
  rolloutStep         Int       @default(10)
  maxRollout          Int       @default(100)
  rollbackThresholds  Json      @default("{}")
  monitoringWindow    Int       @default(3600) // seconds
  lastEvaluatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  learningCandidate LearningCandidate? @relation(fields: [learningCandidateId], references: [id], onDelete: SetNull)

  @@index([learningCandidateId])
  @@map("learning_feature_flags")
}

// Versioned implementation history for a Skill — Skill itself carries only
// the current version's fields (kept for cheap reads); this is full history.
model SkillVersion {
  id                 String    @id @default(cuid())
  skillId            String
  version            Int
  implementationType String?
  implementation     Json?
  dependencies       String[]  @default([])
  inputSchema        Json?
  outputSchema       Json?
  permissions        Json      @default("[]")
  tests              Json      @default("[]")
  benchmarkResultIds String[]  @default([])
  status             String    @default("draft") // draft, candidate, shadow, active, retired, rolled_back
  createdAt          DateTime  @default(now())
  activatedAt        DateTime?
  retiredAt          DateTime?

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@map("learning_skill_versions")
}

model ExperienceReplayRun {
  id                       String   @id @default(cuid())
  category                 String
  sourceTraceIds           String[] @default([])
  summary                  String
  lessons                  Json     @default("[]")
  improvementOpportunities Json     @default("[]")
  knowledgeGapIds          String[] @default([])
  runDate                  DateTime @default(now())
  createdAt                DateTime @default(now())

  @@index([category])
  @@map("learning_experience_replay_runs")
}

// Generalized artifact versioning across prompts/heuristics/routing rules/
// retrieval configs — broader than SkillVersion (which is skill-specific)
// and broader than Agent.promptHistory (which only covers one agent's
// system prompt, capped to the last 10, with no cross-artifact-type history).
model LearningArtifactVersion {
  id                String    @id @default(cuid())
  artifactType      String
  artifactKey       String
  version           Int
  content           Json
  checksum          String?
  status            String    @default("draft") // draft, candidate, shadow, active, retired, rolled_back
  createdByAgentId  String?
  approvedByUserId  String?
  candidateId       String?
  previousVersionId String?
  createdAt         DateTime  @default(now())
  activatedAt       DateTime?
  retiredAt         DateTime?

  candidate       LearningCandidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  previousVersion LearningArtifactVersion?  @relation("ArtifactVersionHistory", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    LearningArtifactVersion[] @relation("ArtifactVersionHistory")

  @@unique([artifactType, artifactKey, version])
  @@map("learning_artifact_versions")
}

// Tracking rows for externally-triggered jobs (no in-process scheduler
// exists in this repo — see docs/LEARNING_CORE_ON_NEURAL_ENGINE.md). Written
// by whatever hits the scheduler API routes (VPS crontab, a scheduled CI
// job, or eventually a real queue worker).
model ScheduledJobRun {
  id          String    @id @default(cuid())
  jobKey      String
  status      String    @default("running") // running, completed, failed
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  result      Json      @default("{}")
  error       String?
  createdAt   DateTime  @default(now())

  @@index([jobKey, startedAt])
  @@map("learning_scheduled_job_runs")
}

// Real persisted Learning Core settings — the "learning-settings" tab was
// previously left as NotYetBuiltView because no backing service existed
// anywhere in this branch (see docs/LEARNING_CORE_ON_NEURAL_ENGINE.md's
// known-gaps section). One row per scope; effective settings for a given
// agent are resolved agent -> workspace -> organization -> hardcoded
// defaults (see getEffectiveLearningSettings in src/lib/learning/settings.ts).
model LearningSettings {
  id                     String   @id @default(cuid())
  scopeType              String // organization, workspace, agent
  scopeId                String
  curiosityThreshold     Float?
  minShadowSampleSize    Int?
  benchmarkThresholds    Json? // e.g. { accuracy: 0.8, maxCostUsd: 1.0, maxLatencyMs: 5000 }
  trustThresholds        Json? // e.g. { autoApproveMinScore: 0.8 }
  rolloutSteps           Int[]    @default([])
  dailyLearningBudgetUsd Float?
  perAgentBudgetUsd      Float?
  replayLimits           Json? // e.g. { maxPerCategory: 50, lookbackDays: 30 }
  modelAllowlist         String[] @default([])
  maxSandboxConcurrency  Int?
  autoDeployEnabled      Boolean  @default(false)
  updatedByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // --- Learning budget (additive; see docs/LEARNING_CORE_EVOLUTION.md) ---
  // Self-improvement resource limits. Null means "no configured limit at this
  // scope" — getEffectiveLearningSettings still resolves agent -> workspace
  // -> organization -> hardcoded defaults, same as every other field here.
  dailyModelBudgetUsd         Float?
  dailyTokenBudget            Int?
  dailyExperimentBudget       Int?
  maxConcurrentExperiments    Int?
  maxCandidatesPerOpportunity Int?
  maxAdversarialRunsPerDay    Int?
  maxReplaySamples            Int?

  @@unique([scopeType, scopeId])
  @@map("learning_settings")
}

// ============================================================================
// Governed Evolutionary Self-Improvement — see docs/LEARNING_CORE_EVOLUTION.md
//
// Extends the Learning Core above. Every model here is genuinely net-new —
// confirmed absent by direct inspection of the schema before writing it.
// LearningCandidate itself is extended in place (see its "Evolution Archive"
// block above) rather than duplicated; these models are the pieces that have
// no existing equivalent: a permanent regression-eval compiler, an
// independent Guardian monitor, sandboxed adversarial self-play, versioned
// principle distillation, and a pipeline-level experiment manifest (distinct
// from ExperimentRun, which is one row per sample/trial, not per pipeline).
// ============================================================================

model EvalSuite {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String // e.g. intent_clarification, retrieval_quality, tool_security
  status      String   @default("active") // active, retired
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases EvalCase[]
  runs  EvalRun[]

  @@index([category])
  @@index([workspaceId])
  @@map("learning_eval_suites")
}

// Provenance-tracked, durable regression test derived from a real production
// failure. Never stores hidden chain-of-thought — only observable behavior
// and evaluation evidence (sanitizedInput/expectedBehavior), redacted the
// same way LearningEvent payloads are (see src/lib/learning/redaction.ts).
model EvalCase {
  id               String   @id @default(cuid())
  suiteId          String?
  source           String // user_correction, rejected_response, thumbs_down, failed_tool_call, failed_workflow, failed_deployment, rollback, bad_retrieval, hallucination, contradiction, unauthorized_action, rejected_approval, security_violation, malformed_code_change, failing_test, delegation_failure, adversarial_run
  sourceId         String? // id of the originating row (Experience, Reflection, LearningCandidate, AdversarialRun, ...)
  userId           String?
  workspaceId      String?
  failureType      String
  severity         String   @default("medium") // low, medium, high, critical
  sanitizedInput   Json     @default("{}")
  expectedBehavior String
  grader           String   @default("rule_based") // deterministic, llm_judge, rule_based
  graderVersion    String   @default("v1")
  confidence       Float    @default(0.5)
  status           String   @default("active") // active, retired, superseded
  // Stable hash of (source, failureType, normalized sanitizedInput) — repeated
  // production failures increment occurrenceCount on the same row instead of
  // creating duplicate regression cases.
  dedupeKey        String   @unique
  occurrenceCount  Int      @default(1)
  redactedKeys     String[] @default([])
  createdAt        DateTime @default(now())

  suite           EvalSuite?       @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  results         EvalResult[]
  adversarialRuns AdversarialRun[]

  @@index([suiteId])
  @@index([source])
  @@index([failureType])
  @@index([workspaceId])
  @@map("learning_eval_cases")
}

model EvalRun {
  id          String    @id @default(cuid())
  suiteId     String?
  candidateId String?
  triggeredBy String // manual, experiment_orchestrator, scheduled, adversarial
  status      String    @default("running") // running, completed, failed
  summary     Json      @default("{}")
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  suite     EvalSuite?         @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  candidate LearningCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  results   EvalResult[]

  @@index([suiteId])
  @@index([candidateId])
  @@map("learning_eval_runs")
}

model EvalResult {
  id             String   @id @default(cuid())
  evalRunId      String
  evalCaseId     String
  candidateId    String?
  passed         Boolean
  score          Float?
  actualBehavior String?
  reasonCodes    String[] @default([])
  createdAt      DateTime @default(now())

  run       EvalRun            @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  evalCase  EvalCase           @relation(fields: [evalCaseId], references: [id], onDelete: Cascade)
  candidate LearningCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([evalRunId])
  @@index([evalCaseId])
  @@index([candidateId])
  @@map("learning_eval_results")
}

// Independent monitoring evidence — Sentinel Guardian. Concise structured
// decision evidence only; no private internal reasoning is persisted here,
// matching the same discipline LearningEvent redaction already enforces.
model GuardianDecision {
  id               String   @id @default(cuid())
  action           String // free-text description of the governed action
  actor            String // agentId or system actor id proposing the action
  runtime          String? // AgentRuntime id/kind, if applicable
  candidateId      String?
  tier             Int // 1, 2, or 3 — mirrors classifyRiskLevel's low/medium/high
  mode             String // observe, review, block
  risk             String // low, medium, high
  policyDecision   String // what the canonical policy-service classification said
  guardianDecision String // allow, hold, block
  confidence       Float?
  reasonCodes      String[] @default([])
  evidence         Json     @default("{}")
  blocked          Boolean  @default(false)
  workspaceId      String?
  createdAt        DateTime @default(now())

  candidate LearningCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([mode])
  @@index([tier])
  @@map("learning_guardian_decisions")
}

// Sandboxed adversarial self-play. One row per attempt; Guardian evidence for
// containment lives in GuardianDecision, not duplicated here. A successful
// attack (outcome = "breached") becomes a permanent EvalCase via
// src/lib/learning/eval-compiler.ts — evalCaseId records that link.
model AdversarialRun {
  id                  String    @id @default(cuid())
  attackType          String // prompt_injection, malicious_tool_output, poisoned_memory, conflicting_instructions, deceptive_web_content, malicious_repository_content, malformed_file, fake_approval, workspace_boundary, path_traversal, prompt_hierarchy_confusion, privilege_escalation, runtime_impersonation, false_telemetry, corrupted_retrieval_context, social_engineering
  candidateId         String? // defender under test (a challenger)
  championCandidateId String? // baseline compared against, if any (plain string — comparison reference, not a cascading relation)
  payload             Json // the crafted attack content (sanitized before persistence)
  targetSurface       String // memory, tool_output, retrieval, approval, runtime, ...
  outcome             String    @default("pending") // pending, blocked, breached, inconclusive
  severity            String    @default("medium")
  judgeNotes          String?
  sandboxViolation    Boolean   @default(false)
  evalCaseId          String?
  workspaceId         String?
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  candidate LearningCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  evalCase  EvalCase?          @relation(fields: [evalCaseId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([attackType])
  @@index([outcome])
  @@map("learning_adversarial_runs")
}

// Distilled, reusable procedural knowledge — never a summarized blob.
// Extends the Skill/Procedure family conceptually but is genuinely distinct:
// a Principle is a conditional behavioral rule with an evidence trail, not an
// executable step sequence. Versioned so behavioral rules are never silently
// overwritten (see PrincipleVersion).
model Principle {
  id                         String    @id @default(cuid())
  statement                  String
  scope                      String // global, workspace, agent, domain
  domain                     String?
  workspaceId                String?
  agentId                    String?
  conditions                 Json      @default("[]")
  exceptions                 Json      @default("[]")
  confidence                 Float     @default(0.5)
  evidenceCount              Int       @default(1)
  supportingExperienceIds    String[]  @default([])
  contradictingExperienceIds String[]  @default([])
  status                     String    @default("active") // active, superseded, retracted
  currentVersion             Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  lastValidatedAt            DateTime?

  versions PrincipleVersion[]

  @@index([domain])
  @@index([workspaceId])
  @@index([agentId])
  @@index([status])
  @@map("learning_principles")
}

model PrincipleVersion {
  id                         String   @id @default(cuid())
  principleId                String
  version                    Int
  statement                  String
  conditions                 Json     @default("[]")
  exceptions                 Json     @default("[]")
  confidence                 Float
  changeReason               String
  supportingExperienceIds    String[] @default([])
  contradictingExperienceIds String[] @default([])
  createdAt                  DateTime @default(now())

  principle Principle @relation(fields: [principleId], references: [id], onDelete: Cascade)

  @@unique([principleId, version])
  @@map("learning_principle_versions")
}

// Pipeline-level record for one candidate's run through the Experiment
// Orchestrator (static validation -> sandbox -> eval suites -> adversarial ->
// replay -> shadow -> fitness -> Guardian -> promotion decision). Distinct
// from ExperimentRun, which is one row per sample/trial within a stage, not
// per pipeline invocation — no existing model covers this granularity.
model ExperimentManifest {
  id                String    @id @default(cuid())
  candidateId       String
  championVersion   String?
  candidateVersion  String?
  evalSuiteIds      String[]  @default([])
  sandboxVersion    String?
  modelVersion      String?
  toolVersions      Json      @default("{}")
  memorySnapshotRef String?
  datasetHash       String?
  graderVersions    Json      @default("{}")
  randomSeed        String?
  // static_validation, sandbox, eval_suites, adversarial, replay, shadow,
  // fitness, guardian, promotion_decision, completed, stopped
  stage             String    @default("static_validation")
  stopReason        String? // budget_exceeded, no_meaningful_improvement, hard_guardrail_failure, guardian_block, required_human_approval, repeated_experiment_failure, unsafe_candidate, infrastructure_unavailable
  results           Json      @default("{}")
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  candidate LearningCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("learning_experiment_manifests")
}

// --- Agent Runtime Control Plane (production/final-agent-control-plane) ---
// Logical Agent identity stays in Agent. These rows describe how an agent is
// executed and deliberately avoid relations back into existing models so this
// additive section can land without rewriting concurrent ownership work.
model AgentRuntime {
  id                   String   @id @default(cuid())
  agentId              String
  kind                 String
  transport            String
  endpoint             String?
  containerName        String?
  serviceName          String?
  executable           String?
  defaultArgs          String[] @default([])
  workingDirectoryRoot String?
  configPath           String?
  logPath              String?
  enabled              Boolean  @default(true)
  capabilities         Json     @default("{}")
  healthConfig         Json     @default("{}")
  workspaceId          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sessions AgentSession[]

  @@index([agentId])
  @@index([kind, enabled])
  @@index([workspaceId])
  @@map("agent_runtimes")
}

model AgentSession {
  id                String    @id @default(cuid())
  runtime           String
  runtimeInstanceId String
  externalSessionId String?
  agentId           String
  userId            String
  workspaceId       String?
  projectId         String?
  chatRoomId        String?
  workingDirectory  String?
  status            String    @default("created")
  startedAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  completedAt       DateTime?
  exitCode          Int?
  cancelledAt       DateTime?
  metadata          Json      @default("{}")
  parentSessionId   String?

  runtimeInstance   AgentRuntime        @relation(fields: [runtimeInstanceId], references: [id], onDelete: Restrict)
  parentSession     AgentSession?       @relation("AgentSessionDelegation", fields: [parentSessionId], references: [id], onDelete: SetNull)
  delegatedSessions AgentSession[]      @relation("AgentSessionDelegation")
  events            AgentRuntimeEvent[]
  messages          Message[]

  @@index([runtimeInstanceId, startedAt])
  @@index([userId, startedAt])
  @@index([workspaceId, startedAt])
  @@index([chatRoomId, lastActivityAt])
  @@index([status, lastActivityAt])
  @@index([parentSessionId])
  @@map("agent_sessions")
}

model AgentRuntimeEvent {
  id         String   @id @default(cuid())
  sessionId  String
  sequence   Int
  type       String
  payload    Json     @default("{}")
  occurredAt DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, occurredAt])
  @@map("agent_runtime_events")
}
