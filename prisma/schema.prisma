generator client {
  provider        = "prisma-client-js"
  // linux-musl-openssl-3.0.x: the app's own Alpine-based deps/builder/most
  // deployments. debian-openssl-3.0.x: the runner stage specifically, which
  // switched to a glibc (Debian slim) base purely so the bind-mounted
  // `claude` CLI binary (glibc-linked) can execute — see Dockerfile.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id                       String            @id @default(cuid())
  email                    String            @unique
  name                     String?
  passwordHash             String?
  createdAt                DateTime          @default(now())
  projects                 Project[]
  chatRooms                ChatRoom[]
  ownedWorkspaces          Workspace[]       @relation("WorkspaceOwner")
  roleAssignments          RoleAssignment[]
  delegatedRoleAssignments RoleAssignment[]  @relation("RoleAssignmentDelegatedBy")
  requestedApprovals       ApprovalRequest[] @relation("ApprovalRequesterUser")
  reviewedApprovals        ApprovalRequest[] @relation("ApprovalReviewer")
  meetingsCreated          Meeting[]         @relation("MeetingCreator")
  auditLogs                AuditLog[]
  knowledgeObjects         KnowledgeObject[]
  notes                    ObsidianNote[]
  workflows                Workflow[]
  ownedBrands              Brand[]           @relation("BrandOwner")

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  userId      String
  workspaceId String?
  teamId      String?
  agents      String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  chatRooms    ChatRoom[]
  workflows    Workflow[]
  notes        ObsidianNote[]
  kanbanBoards KanbanBoard[]
  documents    Document[]
  tasks        Task[]
  meetings     Meeting[]
  approvals    ApprovalRequest[]
  auditLogs    AuditLog[]

  @@index([workspaceId])
  @@index([teamId])
  @@map("projects")
}

model Agent {
  id                 String            @id @default(cuid())
  name               String
  role               String
  avatar             String
  color              String
  model              String
  systemPrompt       String?
  description        String            @default("")
  skills             String[]
  instructionFiles   Json              @default("{}")
  promptHistory      Json              @default("[]")
  toolPermissions    String[]
  memoryScope        String            @default("session")
  status             String            @default("online")
  createdAt          DateTime          @default(now())
  workspaceId        String?
  workspace          Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  roleAssignments    RoleAssignment[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequesterAgent")
  assignedTasks      Task[]            @relation("TaskAgent")
  reviewingTasks     Task[]            @relation("TaskReviewerAgent")

  @@index([workspaceId])
  @@map("agents")
}

model ChatRoom {
  id        String   @id @default(cuid())
  name      String
  projectId String?
  userId    String?
  agentIds  String[]
  createdAt DateTime @default(now())

  // --- Collaboration Room (additive) — a ChatRoom already models a
  // persistent multi-agent workspace, so it doubles as the CollaborationRoom
  // rather than introducing a parallel entity.
  objective     String?
  mode          String  @default("collaborative") // solo, collaborative, autonomous
  autonomyLevel String  @default("assisted") // manual, assisted, autonomous
  paused        Boolean @default(false)

  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages            Message[]
  collabTasks         Task[]               @relation("TaskRoom")
  artifacts           Artifact[]           @relation("ArtifactRoom")
  decisions           Decision[]           @relation("DecisionRoom")
  approvalRequests    ApprovalRequest[]    @relation("ApprovalRequestRoom")
  disagreements       AgentDisagreement[]
  executionLocks      ExecutionLock[]
  collaborationEvents CollaborationEvent[]

  @@map("chat_rooms")
}

model Message {
  id                    String   @id @default(cuid())
  chatRoomId            String
  role                  String
  agentId               String?
  content               String
  toolCalls             Json?
  reasoning             String?
  runtimeKind           String?
  provider              String?
  model                 String?
  agentRuntimeSessionId String?
  createdAt             DateTime @default(now())

  // --- Collaboration Room (additive) — structured AgentMessage protocol.
  messageType       String   @default("MESSAGE") // MESSAGE, DELEGATION, REVIEW_REQUEST, QUESTION, ANSWER, BLOCKER, DECISION, RESULT, CHANGES_REQUESTED
  recipientAgentIds String[] @default([])
  taskId            String?
  artifactIds       String[] @default([])

  chatRoom            ChatRoom      @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  agentRuntimeSession AgentSession? @relation(fields: [agentRuntimeSessionId], references: [id], onDelete: SetNull)
  task                Task?         @relation("TaskMessages", fields: [taskId], references: [id], onDelete: SetNull)

  @@index([agentRuntimeSessionId])
  @@index([chatRoomId, createdAt])
  @@index([taskId])
  @@map("messages")
}

model Memory {
  id              String                       @id @default(cuid())
  type            String
  scope           String
  owner           String
  content         String
  tags            String[]
  embedding       Unsupported("vector(1536)")?
  confidence      Float                        @default(1.0)
  importanceScore Float                        @default(0.5)
  source          String
  pinned          Boolean                      @default(false)
  archived        Boolean                      @default(false)
  projectId       String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  // --- Governed forgetting (additive; see docs/LEARNING_CORE_EVOLUTION.md) ---
  // Net memory value is a configurable/versioned policy computed over these,
  // not a hardcoded formula — see src/lib/learning/memory-governance.ts.
  valueScore         Float?
  harmScore          Float?
  stalenessScore     Float?
  provenanceTrust    Float?
  transferability    Float?
  retrievalCost      Float?
  poisonRisk         Float?
  contradictionCount Int       @default(0)
  confirmationCount  Int       @default(0)
  lastUsefulAt       DateTime?
  lastValidatedAt    DateTime?
  // active, stable, candidate, stale, disputed, quarantined, archived, forgotten
  // "forgotten" removes a memory from normal retrieval without necessarily
  // deleting the row — see excludeFromRetrieval() in memory-governance.ts.
  state              String    @default("active")

  preferenceEvidence UserPreferenceEvidence[]

  @@index([projectId])
  @@index([state])
  @@map("memories")
}

model KanbanBoard {
  id        String   @id @default(cuid())
  name      String
  projectId String?
  columns   Json
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("kanban_boards")
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  nodes       Json
  edges       Json
  status      String   @default("draft")
  projectId   String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@map("workflows")
}

model ObsidianNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[]
  backlinks String[]
  projectId String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@map("obsidian_notes")
}

model AuditLog {
  id                String   @id @default(cuid())
  workspaceId       String?
  projectId         String?
  approvalRequestId String?
  actorType         String   @default("system")
  agentId           String?
  action            String
  entityType        String?
  entityId          String?
  details           Json
  userId            String?
  createdAt         DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Workspace {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  kind           String   @default("general")
  color          String   @default("#6366F1")
  icon           String   @default("LayoutGrid")
  enabled        Boolean  @default(true)
  ownerId        String
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner           User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projects        Project[]
  teams           Team[]
  roles           Role[]
  permissions     Permission[]
  roleAssignments RoleAssignment[]
  approvals       ApprovalRequest[]
  meetings        Meeting[]
  tasks           Task[]
  documents       Document[]
  auditLogs       AuditLog[]
  orgCharts       OrgChart[]
  agents          Agent[]

  @@index([ownerId])
  @@index([organizationId])
  @@map("workspaces")
}

model Team {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  memberUserIds  String[]
  memberAgentIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects        Project[]
  roleAssignments RoleAssignment[]
  tasks           Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("teams")
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions Permission[]
  assignments RoleAssignment[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles     Role[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("permissions")
}

model RoleAssignment {
  id            String    @id @default(cuid())
  workspaceId   String
  roleId        String
  userId        String?
  agentId       String?
  teamId        String?
  expiresAt     DateTime?
  delegatedById String?
  createdAt     DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  delegatedBy User?     @relation("RoleAssignmentDelegatedBy", fields: [delegatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([roleId])
  @@index([userId])
  @@index([agentId])
  @@index([teamId])
  @@index([expiresAt])
  @@map("role_assignments")
}

model ApprovalRequest {
  id               String    @id @default(cuid())
  workspaceId      String
  projectId        String?
  title            String
  description      String?
  type             String    @default("organization_change")
  status           String    @default("pending")
  payload          Json      @default("{}")
  requesterUserId  String?
  requesterAgentId String?
  reviewerUserId   String?
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // --- Collaboration Room (additive) — approval gates scoped to a room/task.
  chatRoomId String?
  taskId     String?
  risk       String  @default("low") // low, medium, high

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requesterUser      User?               @relation("ApprovalRequesterUser", fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterAgent     Agent?              @relation("ApprovalRequesterAgent", fields: [requesterAgentId], references: [id], onDelete: SetNull)
  reviewer           User?               @relation("ApprovalReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  chatRoom           ChatRoom?           @relation("ApprovalRequestRoom", fields: [chatRoomId], references: [id], onDelete: Cascade)
  auditLogs          AuditLog[]
  learningCandidates LearningCandidate[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([chatRoomId, status])
  @@map("approval_requests")
}

// =====================================================================
// Collaboration Room — additive models with no existing equivalent.
// Everything else (rooms, tasks, messages, artifacts, decisions,
// approvals) reuses ChatRoom/Task/Message/Artifact/Decision/ApprovalRequest
// above rather than duplicating them.
// =====================================================================

model AgentDisagreement {
  id                String    @id @default(cuid())
  chatRoomId        String
  taskId            String?
  issue             String
  positions         Json      @default("[]") // { agentId, position, evidence? }[]
  severity          String    @default("medium") // low, medium, high
  resolvedByAgentId String?
  finalDecision     String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([chatRoomId, resolvedAt])
  @@index([taskId])
  @@map("agent_disagreements")
}

model ExecutionLock {
  id               String    @id @default(cuid())
  chatRoomId       String
  taskId           String?
  agentId          String
  resourcePattern  String // glob over files/paths this lock covers, e.g. "src/lib/orchestration/**"
  mode             String    @default("write") // read, write
  workingDirectory String?
  branch           String?
  worktreePath     String?
  createdAt        DateTime  @default(now())
  releasedAt       DateTime?

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([chatRoomId, releasedAt])
  @@index([taskId])
  @@map("execution_locks")
}

model CollaborationEvent {
  id         String   @id @default(cuid())
  chatRoomId String
  sequence   Int
  type       String // room.created, agent.joined, task.claimed, approval.requested, ... (spec §18)
  payload    Json     @default("{}")
  occurredAt DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, sequence])
  @@index([chatRoomId, occurredAt])
  @@map("collaboration_events")
}

model Meeting {
  id               String   @id @default(cuid())
  workspaceId      String
  projectId        String?
  title            String
  agenda           String?
  startsAt         DateTime
  endsAt           DateTime
  status           String   @default("scheduled")
  attendeeUserIds  String[]
  attendeeAgentIds String[]
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User      @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([projectId])
  @@map("meetings")
}

model Task {
  id               String    @id @default(cuid())
  workspaceId      String?
  projectId        String?
  teamId           String?
  contentProjectId String?
  title            String
  description      String?
  status           String    @default("backlog")
  priority         String    @default("medium")
  assignee         String?
  agentId          String?
  dueDate          DateTime?
  tags             String[]
  position         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // --- Collaboration Room (additive) — lets a Task double as a
  // CollaborationTask node in a room's DAG without a parallel task model.
  // Collaboration tasks use a richer status vocabulary (PLANNED, QUEUED,
  // CLAIMED, RUNNING, BLOCKED, WAITING_REVIEW, CHANGES_REQUESTED,
  // APPROVAL_REQUIRED, COMPLETED, FAILED, CANCELLED) than the plain
  // kanban `status` column above; both share the untyped string column
  // and are distinguished by chatRoomId being set.
  chatRoomId       String?
  reviewerAgentId  String?
  createdByAgentId String?
  dependsOnTaskIds String[] @default([])

  workspace      Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  agent          Agent?              @relation("TaskAgent", fields: [agentId], references: [id], onDelete: SetNull)
  contentProject ContentProject?     @relation("ContentProjectTasks", fields: [contentProjectId], references: [id], onDelete: Cascade)
  chatRoom       ChatRoom?           @relation("TaskRoom", fields: [chatRoomId], references: [id], onDelete: Cascade)
  reviewerAgent  Agent?              @relation("TaskReviewerAgent", fields: [reviewerAgentId], references: [id], onDelete: SetNull)
  messages       Message[]           @relation("TaskMessages")
  artifacts      Artifact[]          @relation("ArtifactTask")
  disagreements  AgentDisagreement[]
  executionLocks ExecutionLock[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([contentProjectId])
  @@index([chatRoomId, status])
  @@map("tasks")
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String?
  projectId   String?
  title       String
  content     String   @default("")
  type        String   @default("markdown")
  tags        String[]
  pinned      Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@map("documents")
}

model OrgChart {
  id          String   @id @default(cuid())
  workspaceId String?
  name        String   @default("Main")
  nodes       Json
  edges       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("org_charts")
}

model InstalledModule {
  id          String   @id @default(cuid())
  moduleId    String   @unique
  enabled     Boolean  @default(true)
  version     String   @default("1.0.0")
  manifest    Json     @default("{}")
  config      Json     @default("{}")
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("installed_modules")
}

model CustomModule {
  id          String   @id @default(cuid())
  moduleId    String   @unique
  label       String
  name        String?
  description String?
  icon        String   @default("Package")
  category    String   @default("custom")
  href        String?
  contentType String   @default("markdown")
  content     String   @default("")
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custom_modules")
}

model KnowledgeObject {
  id             String   @id @default(cuid())
  type           String // Note, Memory, Project, Workspace, Agent, Person, Organization, Task, Decision, Workflow, File, Repository, Module, Artifact, Conversation, Message
  title          String
  summary        String?
  sourceType     String // which table this bridges from (e.g. "memory", "agent", "project", "chat_room")
  sourceId       String // the id in the source table
  scope          String   @default("project") // session, project, workspace, organization, user, global
  workspaceId    String?
  projectId      String?
  organizationId String?
  userId         String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // --- Temporal Graph (Layer 3) — additive, nullable/defaulted so existing
  // rows and call sites are unaffected. supersession over deletion.
  version              Int       @default(1)
  validFrom            DateTime  @default(now())
  validTo              DateTime?
  supersededByObjectId String?
  changeReason         String?
  changedBy            String?
  sourceEventId        String?

  fromEdges    KnowledgeEdge[]        @relation("EdgeFrom")
  toEdges      KnowledgeEdge[]        @relation("EdgeTo")
  agentWeights AgentKnowledgeWeight[]
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  supersedes   KnowledgeObject?  @relation("ObjectSupersession", fields: [supersededByObjectId], references: [id])
  supersededBy KnowledgeObject[] @relation("ObjectSupersession")

  @@unique([sourceType, sourceId, userId])
  @@index([scope])
  @@index([projectId])
  @@index([userId])
  @@index([validTo])
  @@map("knowledge_objects")
}

model KnowledgeEdge {
  id           String   @id @default(cuid())
  fromObjectId String
  toObjectId   String
  type         String // references, belongs_to, created_by, assigned_to, generated_by, depends_on, remembers, related_to, supersedes, supports, contradicts, learned_from, used_by, trusted_by, failed_on, succeeded_on, governs, reports_to
  weight       Float    @default(1.0)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  // --- Temporal Graph (Layer 3) — additive.
  version       Int       @default(1)
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  changeReason  String?
  changedBy     String?
  sourceEventId String?

  fromObject KnowledgeObject @relation("EdgeFrom", fields: [fromObjectId], references: [id], onDelete: Cascade)
  toObject   KnowledgeObject @relation("EdgeTo", fields: [toObjectId], references: [id], onDelete: Cascade)

  @@unique([fromObjectId, toObjectId, type])
  @@index([fromObjectId, type])
  @@index([toObjectId, type])
  @@index([validTo])
  @@map("knowledge_edges")
}

model Decision {
  id                   String   @id @default(cuid())
  title                String
  summary              String
  status               String   @default("proposed") // proposed, approved, rejected, superseded
  rationale            String?
  alternatives         Json     @default("[]")
  sourceLinks          Json     @default("[]")
  approvalHistory      Json     @default("[]")
  createdBy            String
  approvedBy           String?
  supersedesDecisionId String?
  projectId            String?
  userId               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // --- Temporal Graph (Layer 3) — additive.
  version       Int       @default(1)
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  changeReason  String?
  changedBy     String?
  sourceEventId String?

  // --- Collaboration Room (additive) — the decision ledger (spec §47).
  chatRoomId     String?
  relatedTaskIds String[] @default([])

  supersedes   Decision?  @relation("DecisionSupersedes", fields: [supersedesDecisionId], references: [id])
  supersededBy Decision[] @relation("DecisionSupersedes")
  chatRoom     ChatRoom?  @relation("DecisionRoom", fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([chatRoomId])
  @@map("decisions")
}

// =====================================================================
// Sentinel Neural Engine — Phase A additions
// =====================================================================
// Organization / Department / Workspace: real tables backing the scope
// tags already present on KnowledgeObject (workspaceId/organizationId were
// previously untyped strings with nothing to point at).

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments Department[]
  workspaces  Workspace[]

  @@map("neural_organizations")
}

model Department {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  organizationId     String
  parentDepartmentId String?
  leadUserId         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  children     Department[] @relation("DepartmentHierarchy")

  @@index([organizationId])
  @@map("neural_departments")
}

// --- Skill / Procedure / Policy ---------------------------------------
// Deliberately separate tables (not one "reusable behavior" type) per the
// hard rule against collapsing object types.

model Skill {
  id             String   @id @default(cuid())
  name           String
  description    String
  domain         String
  steps          Json     @default("[]")
  requiredTools  String[] @default([])
  constraints    Json     @default("{}")
  successMetrics Json     @default("{}")
  evidenceLinks  String[] @default([])
  version        Int      @default(1)
  owner          String?
  status         String   @default("proposed") // proposed, active, deprecated, rolled_back
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Learning Core additions — versioned implementation/schema/tests live in
  // SkillVersion; these top-level fields describe the current version only.
  inputSchema  Json?
  outputSchema Json?
  permissions  Json  @default("[]")
  tests        Json  @default("[]")

  // Ownership for tenant scoping (production/final-agent-control-plane).
  // Additive, nullable — no reliable way to backfill which workspace
  // pre-existing skills belong to. A null workspaceId means the row is
  // invisible to every tenant-scoped list/read; it never falls back to
  // global visibility. See docs/reviews/PR21_POST_MERGE_RECONCILIATION.md.
  workspaceId String?

  versions SkillVersion[]

  @@index([domain])
  @@index([status])
  @@index([workspaceId])
  @@map("neural_skills")
}

model Procedure {
  id             String   @id @default(cuid())
  name           String
  description    String
  domain         String
  steps          Json     @default("[]")
  requiredTools  String[] @default([])
  constraints    Json     @default("{}")
  successMetrics Json     @default("{}")
  evidenceLinks  String[] @default([])
  version        Int      @default(1)
  owner          String?
  status         String   @default("proposed") // proposed, active, deprecated, rolled_back
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([domain])
  @@index([status])
  @@map("neural_procedures")
}

model Policy {
  id          String   @id @default(cuid())
  name        String
  domain      String
  description String
  rules       Json     @default("{}")
  appliesTo   Json     @default("{}")
  riskLevel   String   @default("high") // low, medium, high — governs auto-approve eligibility
  status      String   @default("active") // active, retired
  owner       String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
  @@map("neural_policies")
}

// --- Experience Graph (Layer 2) ----------------------------------------
// Agents write Experiences. Agents do not directly rewrite canonical
// knowledge — only approved LearningCandidates do (via learning-service).

model Experience {
  id                String    @id @default(cuid())
  agentId           String
  projectId         String?
  workspaceId       String?
  organizationId    String?
  taskId            String?
  conversationId    String?
  objective         String
  // Learning Core — Intent Discovery (additive, nullable; see docs/LEARNING_CORE_ON_NEURAL_ENGINE.md)
  underlyingGoal    String?
  constraints       Json      @default("[]")
  successCriteria   Json      @default("[]")
  parentTraceId     String? // another Experience.id, for nested/sub-task traces
  contextSnapshot   Json      @default("{}")
  actionsTaken      Json      @default("[]")
  toolsUsed         String[]  @default([])
  knowledgeUsed     String[]  @default([]) // KnowledgeObject ids consulted
  outputArtifactIds String[]  @default([])
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  cost              Float?
  latencyMs         Int?
  outcomeStatus     String    @default("in_progress") // in_progress, success, partial, failure, cancelled
  userFeedback      String?
  evaluatorScore    Float?
  evaluatorSummary  String?
  createdAt         DateTime  @default(now())

  outcome            Outcome?
  evaluations        Evaluation[]
  learningCandidates LearningCandidate[]

  @@index([agentId])
  @@index([projectId])
  @@index([outcomeStatus])
  @@map("neural_experiences")
}

model Outcome {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  status          String // success, partial, failure, cancelled
  metrics         Json     @default("{}")
  errors          Json     @default("[]")
  externalSignals Json     @default("{}")
  userAccepted    Boolean?
  createdAt       DateTime @default(now())

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("neural_outcomes")
}

model Evaluation {
  id               String   @id @default(cuid())
  experienceId     String
  evaluatorAgentId String?
  successScore     Float?
  qualityScore     Float?
  efficiencyScore  Float?
  safetyScore      Float?
  confidence       Float    @default(0.5)
  critique         String?
  evidence         Json     @default("{}")
  createdAt        DateTime @default(now())

  experience         Experience          @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  learningCandidates LearningCandidate[]

  @@index([experienceId])
  @@map("neural_evaluations")
}

model LearningCandidate {
  id              String    @id @default(cuid())
  experienceId    String?
  evaluationId    String?
  type            String // memory, decision, skill, procedure, relationship, confidence_update, contradiction, prompt_change, tool_policy_change
  proposedPayload Json
  targetType      String? // knowledge_object, knowledge_edge, skill, procedure, agent_weight
  appliedTargetId String? // id of the object created/updated once approved
  riskLevel       String    @default("medium") // low, medium, high
  evidenceCount   Int       @default(1)
  confidence      Float     @default(0.5)
  status          String    @default("proposed") // proposed, approved, rejected, auto_approved, rolled_back
  reviewedBy      String?
  rollbackOf      String? // LearningCandidate.id this one rolls back, if any
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  // Learning Core additions (additive, nullable; see docs/LEARNING_CORE_ON_NEURAL_ENGINE.md).
  // LearningCandidate already covers what a separate spec would call
  // Hypothesis + ImprovementProposal + Experiment — these fields extend it
  // rather than forking three new models.
  knowledgeGapId    String?
  problem           String? // why this was proposed, distinct from proposedPayload's what
  rootCause         String?
  rollbackCriteria  Json?
  testPlan          Json?
  rolloutPlan       Json?
  approvalRequestId String? // set for candidates that need human review via the generic workspace approval flow
  shadowSampleSize  Int?
  shadowConfidence  Float?

  // --- Evolution Archive (additive; see docs/LEARNING_CORE_EVOLUTION.md) ---
  // `status` above remains the approval-workflow field (proposed/approved/
  // rejected/auto_approved/rolled_back) exactly as before — untouched.
  // `survivalStatus` is a separate, additive axis describing this candidate's
  // place in the evolutionary archive; the two are orthogonal (a candidate
  // can be `approved` and `challenger` at the same time).
  parentCandidateId String? // another LearningCandidate.id this one descended from
  rootCandidateId   String? // the original ancestor's id (plain string — no cascading relation semantics, matches the agentId convention elsewhere in this file)
  generation        Int     @default(0)
  lineageDepth      Int     @default(0)
  mutationType      String? // e.g. weight_adjustment, strategy_change, hybrid, crossover, mutation
  createdFrom       String? // free-text provenance, e.g. "opportunity:<knowledgeGapId>", "mutation:<parentCandidateId>", "manual"
  noveltyScore      Float?
  fitnessScore      Float?
  fitnessVector     Json? // { taskSuccess, accuracy, userCorrectionRate, hallucinationRate, toolSuccess, clarificationQuality, retrievalQuality, latency, tokenCost, monetaryCost, safety, security, userPreferenceAlignment, generalization, robustness, novelty }
  survivalStatus    String  @default("generated") // generated, testing, archive, challenger, champion, rejected, superseded, rolled_back, unsafe
  championGroup     String? // groups challengers competing over the same improvable subsystem, e.g. "retrieval_ranking", "clarification_policy"
  evaluationCount   Int     @default(0)
  archiveStatus     String  @default("retained") // retained, pruned — archive never deletes; this only marks low-priority rows for UI collapsing
  generatorModel    String? // which model proposed this candidate (model diversity, see docs)
  evaluatorModel    String? // which model evaluated it

  experience Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  knowledgeGap     KnowledgeGap?             @relation(fields: [knowledgeGapId], references: [id], onDelete: SetNull)
  approvalRequest  ApprovalRequest?          @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  experimentRuns   ExperimentRun[]
  benchmarkResults BenchmarkResult[]
  trustEvents      TrustEvent[]
  featureFlags     FeatureFlag[]
  artifactVersions LearningArtifactVersion[]

  parentCandidate LearningCandidate?  @relation("CandidateLineage", fields: [parentCandidateId], references: [id], onDelete: SetNull)
  descendants     LearningCandidate[] @relation("CandidateLineage")

  evalResults         EvalResult[]
  evalRuns            EvalRun[]
  guardianDecisions   GuardianDecision[]
  adversarialRuns     AdversarialRun[]
  experimentManifests ExperimentManifest[]

  @@index([status])
  @@index([riskLevel])
  @@index([type])
  @@index([knowledgeGapId])
  @@index([approvalRequestId])
  @@index([parentCandidateId])
  @@index([rootCandidateId])
  @@index([survivalStatus])
  @@index([championGroup])
  @@map("neural_learning_candidates")
}

// --- Agent State Graph (Layer 4) ---------------------------------------

model AgentKnowledgeProfile {
