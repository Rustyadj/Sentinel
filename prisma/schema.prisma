generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String            @id @default(cuid())
  email                    String            @unique
  name                     String?
  passwordHash             String?
  createdAt                DateTime          @default(now())
  projects                 Project[]
  chatRooms                ChatRoom[]
  ownedWorkspaces          Workspace[]       @relation("WorkspaceOwner")
  roleAssignments          RoleAssignment[]
  delegatedRoleAssignments RoleAssignment[]  @relation("RoleAssignmentDelegatedBy")
  requestedApprovals       ApprovalRequest[] @relation("ApprovalRequesterUser")
  reviewedApprovals        ApprovalRequest[] @relation("ApprovalReviewer")
  meetingsCreated          Meeting[]         @relation("MeetingCreator")
  auditLogs                AuditLog[]
  ownedBrands              Brand[]           @relation("BrandOwner")
  ownedAgents              Agent[]           @relation("AgentOwner")

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  userId      String
  workspaceId String?
  teamId      String?
  agents      String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  chatRooms    ChatRoom[]
  workflows    Workflow[]
  notes        ObsidianNote[]
  kanbanBoards KanbanBoard[]
  documents    Document[]
  tasks        Task[]
  meetings     Meeting[]
  approvals    ApprovalRequest[]
  auditLogs    AuditLog[]

  @@index([workspaceId])
  @@index([teamId])
  @@map("projects")
}

// Agent is an identity/control-plane record only: who this agent is, what it
// can do, and what it links to. Volatile runtime metrics (CPU/memory/token
// counters/cost accumulators) never live here — they belong in dedicated
// time-series-shaped tables introduced when something actually consumes them
// (see docs/AGENT_OPS_CENTER_PLAN.md).
model Agent {
  id            String   @id @default(cuid())
  name          String
  role          String
  avatar        String
  color         String
  description   String   @default("")
  skills        String[] // stable capability tags, not live telemetry
  status        String   @default("online") // coarse control-plane state, hand-set/derived — not a metrics feed
  ownerId       String?
  version       String   @default("1.0.0")
  promptVersion String   @default("1.0.0")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner              User?               @relation("AgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  configuration      AgentConfiguration?
  instances          AgentInstance[]
  healthChecks       AgentHealthCheck[]
  events             AgentEvent[]
  roleAssignments    RoleAssignment[]
  requestedApprovals ApprovalRequest[]   @relation("ApprovalRequesterAgent")
  assignedTasks      Task[]              @relation("TaskAgent")

  // Learning Core (see docs/LEARNING_CORE_PLAN.md)
  curiosityEvents CuriosityEvent[]
  knowledgeGaps   KnowledgeGap[]
  reflections     Reflection[]
  trustScore      AgentTrustScore?
  trustEvents     TrustEvent[]

  @@map("agents")
}

// Persisted configuration — how this agent behaves. 1:1 with Agent.
model AgentConfiguration {
  id                String   @id @default(cuid())
  agentId           String   @unique
  model             String   @default("claude-sonnet-4-6")
  systemPrompt      String   @default("")
  temperature       Float    @default(0.7)
  reasoningMode     String   @default("standard")
  memoryScope       String   @default("session") // session, project, workspace, global
  workspaceAccess   String[] @default([])
  allowedTools      String[] @default([])
  allowedMcpServers String[] @default([])
  budgets           Json     @default("{}")
  rateLimits        Json     @default("{}")
  instructionFiles  Json     @default("{}")
  promptHistory     Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_configurations")
}

// Runtime instance + provider identity — a concrete deployed process backing
// an agent (e.g. a VPS-hosted Claude Code process). One agent identity can
// have zero (pure chat persona), one, or multiple bound instances.
model AgentInstance {
  id              String   @id @default(cuid())
  agentId         String
  kind            String // hermes, openclaw, custom
  type            String // claude-code-agent, open-webui-agent, ...
  provider        String? // anthropic, openai, local
  authMode        String? // oauth, api-key, local
  model           String?
  endpoint        String?
  configPath      String?
  logPath         String?
  dashboardPort   Int?
  legacyPath      String?
  vpsWorkspaceTag String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_instances")
}

// Discrete health check results (last-known-status snapshots), not a metrics
// time series. A dedicated metrics store is a later, explicitly-scoped phase.
model AgentHealthCheck {
  id         String   @id @default(cuid())
  agentId    String
  instanceId String?
  status     String // online, offline, degraded, unknown
  latencyMs  Int?
  details    Json     @default("{}")
  checkedAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, checkedAt])
  @@map("agent_health_checks")
}

// Event history — the append-only source for activity feeds and replay.
model AgentEvent {
  id        String   @id @default(cuid())
  agentId   String
  type      String // delegation, tool_call, memory_retrieval, status_change, task_completed, approval_requested, error, restart, reload, message
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("agent_events")
}

model ChatRoom {
  id        String   @id @default(cuid())
  name      String
  projectId String?
  userId    String?
  agentIds  String[]
  createdAt DateTime @default(now())

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages Message[]

  @@map("chat_rooms")
}

model Message {
  id         String   @id @default(cuid())
  chatRoomId String
  role       String
  agentId    String?
  content    String
  toolCalls  Json?
  reasoning  String?
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Memory {
  id              String   @id @default(cuid())
  type            String
  scope           String
  owner           String
  content         String
  tags            String[]
  embedding       String?
  confidence      Float    @default(1.0)
  importanceScore Float    @default(0.5)
  source          String
  pinned          Boolean  @default(false)
  archived        Boolean  @default(false)
  projectId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@map("memories")
}

model KanbanBoard {
  id        String   @id @default(cuid())
  name      String
  projectId String?
  columns   Json
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("kanban_boards")
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  nodes       Json
  edges       Json
  status      String   @default("draft")
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("workflows")
}

model ObsidianNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[]
  backlinks String[]
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("obsidian_notes")
}

model AuditLog {
  id                String   @id @default(cuid())
  workspaceId       String?
  projectId         String?
  approvalRequestId String?
  actorType         String   @default("system")
  agentId           String?
  action            String
  entityType        String?
  entityId          String?
  details           Json
  userId            String?
  createdAt         DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Workspace {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  kind        String   @default("general")
  color       String   @default("#6366F1")
  icon        String   @default("LayoutGrid")
  enabled     Boolean  @default(true)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  projects        Project[]
  teams           Team[]
  roles           Role[]
  permissions     Permission[]
  roleAssignments RoleAssignment[]
  approvals       ApprovalRequest[]
  meetings        Meeting[]
  tasks           Task[]
  documents       Document[]
  auditLogs       AuditLog[]
  orgCharts       OrgChart[]

  @@index([ownerId])
  @@map("workspaces")
}

model Team {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  memberUserIds  String[]
  memberAgentIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects        Project[]
  roleAssignments RoleAssignment[]
  tasks           Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("teams")
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions Permission[]
  assignments RoleAssignment[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles     Role[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("permissions")
}

model RoleAssignment {
  id            String    @id @default(cuid())
  workspaceId   String
  roleId        String
  userId        String?
  agentId       String?
  teamId        String?
  expiresAt     DateTime?
  delegatedById String?
  createdAt     DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  delegatedBy User?     @relation("RoleAssignmentDelegatedBy", fields: [delegatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([roleId])
  @@index([userId])
  @@index([agentId])
  @@index([teamId])
  @@index([expiresAt])
  @@map("role_assignments")
}

model ApprovalRequest {
  id               String    @id @default(cuid())
  workspaceId      String
  projectId        String?
  title            String
  description      String?
  type             String    @default("organization_change")
  status           String    @default("pending")
  payload          Json      @default("{}")
  requesterUserId  String?
  requesterAgentId String?
  reviewerUserId   String?
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requesterUser  User?      @relation("ApprovalRequesterUser", fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterAgent Agent?     @relation("ApprovalRequesterAgent", fields: [requesterAgentId], references: [id], onDelete: SetNull)
  reviewer       User?      @relation("ApprovalReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@map("approval_requests")
}

model Meeting {
  id               String   @id @default(cuid())
  workspaceId      String
  projectId        String?
  title            String
  agenda           String?
  startsAt         DateTime
  endsAt           DateTime
  status           String   @default("scheduled")
  attendeeUserIds  String[]
  attendeeAgentIds String[]
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User      @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([projectId])
  @@map("meetings")
}

model Task {
  id               String    @id @default(cuid())
  workspaceId      String?
  projectId        String?
  teamId           String?
  contentProjectId String?
  title            String
  description      String?
  status           String    @default("backlog")
  priority         String    @default("medium")
  assignee         String?
  agentId          String?
  dueDate          DateTime?
  tags             String[]
  position         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  agent          Agent?          @relation("TaskAgent", fields: [agentId], references: [id], onDelete: SetNull)
  contentProject ContentProject? @relation("ContentProjectTasks", fields: [contentProjectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([contentProjectId])
  @@map("tasks")
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String?
  projectId   String?
  title       String
  content     String   @default("")
  type        String   @default("markdown")
  tags        String[]
  pinned      Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@map("documents")
}

model OrgChart {
  id          String   @id @default(cuid())
  workspaceId String?
  name        String   @default("Main")
  nodes       Json
  edges       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("org_charts")
}

model InstalledModule {
  id          String   @id @default(cuid())
  moduleId    String   @unique
  enabled     Boolean  @default(true)
  version     String   @default("1.0.0")
  manifest    Json     @default("{}")
  config      Json     @default("{}")
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("installed_modules")
}

model CustomModule {
  id          String   @id @default(cuid())
  moduleId    String   @unique
  label       String
  name        String?
  description String?
  icon        String   @default("Package")
  category    String   @default("custom")
  href        String?
  contentType String   @default("markdown")
  content     String   @default("")
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custom_modules")
}

model KnowledgeObject {
  id             String   @id @default(cuid())
  type           String // Note, Memory, Project, Workspace, Agent, Person, Organization, Task, Decision, Workflow, File, Repository, Module, Artifact, Conversation, Message
  title          String
  summary        String?
  sourceType     String // which table this bridges from (e.g. "memory", "agent", "project", "chat_room")
  sourceId       String // the id in the source table
  scope          String   @default("project") // session, project, workspace, organization, user, global
  workspaceId    String?
  projectId      String?
  organizationId String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromEdges KnowledgeEdge[] @relation("EdgeFrom")
  toEdges   KnowledgeEdge[] @relation("EdgeTo")

  @@index([sourceType, sourceId])
  @@index([scope])
  @@index([projectId])
  @@map("knowledge_objects")
}

model KnowledgeEdge {
  id           String   @id @default(cuid())
  fromObjectId String
  toObjectId   String
  type         String // references, belongs_to, created_by, assigned_to, generated_by, depends_on, remembers, related_to, supersedes
  weight       Float    @default(1.0)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  fromObject KnowledgeObject @relation("EdgeFrom", fields: [fromObjectId], references: [id], onDelete: Cascade)
  toObject   KnowledgeObject @relation("EdgeTo", fields: [toObjectId], references: [id], onDelete: Cascade)

  @@unique([fromObjectId, toObjectId, type])
  @@index([fromObjectId, type])
  @@index([toObjectId, type])
  @@map("knowledge_edges")
}

model Decision {
  id                   String   @id @default(cuid())
  title                String
  summary              String
  status               String   @default("proposed") // proposed, approved, rejected, superseded
  rationale            String?
  alternatives         Json     @default("[]")
  sourceLinks          Json     @default("[]")
  approvalHistory      Json     @default("[]")
  createdBy            String
  approvedBy           String?
  supersedesDecisionId String?
  projectId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  supersedes   Decision?  @relation("DecisionSupersedes", fields: [supersedesDecisionId], references: [id])
  supersededBy Decision[] @relation("DecisionSupersedes")

  @@index([projectId])
  @@map("decisions")
}

model Artifact {
  id          String   @id @default(cuid())
  type        String // generated_app, generated_website, generated_api, generated_module, generated_prompt, generated_diagram, generated_workflow
  title       String
  description String?
  content     String? // text content if small enough
  storageUrl  String? // external storage reference
  mimeType    String?
  projectId   String?
  createdBy   String // agent id or user id
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("artifacts")
}

model Brand {
  id        String   @id @default(cuid())
  ownerId   String
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User             @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profile  BrandProfile?
  ideas    Idea[]
  projects ContentProject[]
  items    ContentItem[]
  assets   Asset[]

  @@index([ownerId])
  @@map("creator_studio_brands")
}

// Asset Library — URL-reference based (no file storage backend exists in this
// codebase yet; uploading/hosting binary files is a separate infra decision).
// Also backs Brand Kit: assets tagged with a kit-slot category (logo, intro,
// outro, watermark, lower_third, transition, thumbnail_template) are the
// brand's curated creative kit, not a separate model.
model Asset {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  category  String // video, photo, logo, music, font, animation, icon, b_roll, document, intro, outro, watermark, lower_third, transition, thumbnail_template
  url       String
  mimeType  String?
  sizeBytes Int?
  tags      String[]
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, category])
  @@map("creator_studio_assets")
}

model ContentProject {
  id          String   @id @default(cuid())
  brandId     String
  name        String
  description String?
  status      String   @default("active") // active, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items ContentItem[]
  tasks Task[]        @relation("ContentProjectTasks")

  @@index([brandId])
  @@map("creator_studio_projects")
}

model ContentItem {
  id           String    @id @default(cuid())
  brandId      String
  projectId    String?
  sourceItemId String? // set when this item (typically a "short") was generated from another item's content
  title        String
  type         String    @default("video") // video, short, social, blog, podcast
  status       String    @default("idea") // idea, research, writing, editing, review, scheduled, published, archived
  platform     String?
  content      String?
  description  String? // YouTube/platform description field
  thumbnailUrl String? // final chosen thumbnail image — pasted in, no image-gen/storage backend exists
  chapters     Json      @default("[]") // [{ timestamp: "0:00", title: "Intro" }, ...]
  outline      Json      @default("[]") // [{ id, text }, ...] — script outline beats
  scheduledAt  DateTime?
  publishedAt  DateTime?
  tags         String[]
  position     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  project      ContentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceItem   ContentItem?    @relation("ContentItemDerivedFrom", fields: [sourceItemId], references: [id], onDelete: SetNull)
  derivedItems ContentItem[]   @relation("ContentItemDerivedFrom")
  hooks        ContentHook[]

  @@index([brandId, status])
  @@index([projectId])
  @@index([sourceItemId])
  @@map("creator_studio_items")
}

model ContentHook {
  id            String   @id @default(cuid())
  contentItemId String
  style         String // curiosity, authority, fear, statistics, question, contrarian, story, problem_solution
  text          String
  selected      Boolean  @default(false)
  createdAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@map("creator_studio_hooks")
}

model BrandProfile {
  id              String   @id @default(cuid())
  brandId         String   @unique
  logoUrl         String?
  primaryColor    String   @default("#6366F1")
  secondaryColor  String   @default("#8B5CF6")
  typography      Json     @default("{}")
  mission         String?
  targetAudience  String?
  painPoints      String[]
  toneOfVoice     String?
  products        String[]
  services        String[]
  competitors     String[]
  frequentPhrases String[]
  wordsToAvoid    String[]
  ctaPreferences  String?
  thumbnailStyle  String?
  videoStyle      String?
  hookStyle       String?
  seoKeywords     String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("creator_studio_brand_profiles")
}

model Idea {
  id                String   @id @default(cuid())
  brandId           String
  title             String
  content           String?
  source            String   @default("manual") // manual, voice_note, url, tweet, article, reddit, youtube, customer_question, competitor
  sourceUrl         String?
  tags              String[]
  knowledgeObjectId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("creator_studio_ideas")
}

model KnowledgeEvent {
  id          String   @id @default(cuid())
  type        String // object_created, object_updated, edge_created, candidate_proposed, candidate_accepted, candidate_rejected
  payload     Json
  roomId      String?
  workspaceId String?
  projectId   String?
  createdAt   DateTime @default(now())

  @@map("knowledge_events")
}

// ============================================================================
// Learning Core — see docs/LEARNING_CORE_PLAN.md
//
// Split into two ownership halves that share this schema but own disjoint
// services/pages, so both can build in parallel without touching each
// other's files:
//   Observation half (Claude): CuriosityEvent, KnowledgeGap, Reflection,
//     ReplayEntry, Preference, Goal, GoalAlignmentCheck
//   Improvement half (Codex): Hypothesis, Experiment, Benchmark,
//     AgentTrustScore, TrustEvent, Skill, EvolutionEvent, FeatureFlag
// ============================================================================

model CuriosityEvent {
  id             String   @id @default(cuid())
  agentId        String
  score          Float
  factors        Json // confidence, missingInfo, contradictions, toolFailures, unknownTerms, etc.
  triggerContext String?
  question       String?
  resolved       Boolean  @default(false)
  resolution     String?
  createdAt      DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("learning_curiosity_events")
}

model KnowledgeGap {
  id               String   @id @default(cuid())
  agentId          String
  topic            String
  description      String
  occurrenceCount  Int      @default(1)
  confidence       Float    @default(0)
  priority         String   @default("medium") // low, medium, high
  status           String   @default("open") // open, learning, resolved
  estimatedBenefit String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, topic])
  @@map("learning_knowledge_gaps")
}

model Reflection {
  id               String   @id @default(cuid())
  agentId          String
  taskRef          String? // loose pointer: conversation id, task id, workflow run id
  wentWell         String?
  wentWrong        String?
  surprises        String?
  wrongAssumptions String?
  missingInfo      String?
  shouldRemember   String?
  skillIdea        String?
  shouldAskMore    Boolean  @default(false)
  createdAt        DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("learning_reflections")
}

model ReplayEntry {
  id                       String   @id @default(cuid())
  category                 String // failure, success, expensive, slow, hallucination, tool_failure, memory_mistake, reflection_failure
  sourceRef                String?
  summary                  String
  lessons                  Json     @default("[]")
  improvementOpportunities Json     @default("[]")
  runDate                  DateTime @default(now())
  createdAt                DateTime @default(now())

  @@index([category])
  @@map("learning_replay_entries")
}

model Preference {
  id                    String    @id @default(cuid())
  userId                String?
  key                   String
  value                 Json
  confidence            Float     @default(0.5)
  sourceConversationIds String[]  @default([])
  lastConfirmedAt       DateTime  @default(now())
  expiresAt             DateTime?
  conflicts             Json      @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, key])
  @@map("learning_preferences")
}

model Goal {
  id                String   @id @default(cuid())
  taskRef           String?
  requestedGoal     String
  underlyingGoal    String?
  constraints       String[] @default([])
  successCriteria   String[] @default([])
  hiddenPreferences Json     @default("{}")
  businessImpact    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  alignmentChecks GoalAlignmentCheck[]

  @@map("learning_goals")
}

model GoalAlignmentCheck {
  id             String   @id @default(cuid())
  goalId         String?
  actionRef      String
  alignmentScore Float
  suggestion     String?
  createdAt      DateTime @default(now())

  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@map("learning_goal_alignment_checks")
}

model Hypothesis {
  id                  String   @id @default(cuid())
  title               String
  problem             String
  rootCause           String?
  expectedImprovement String
  risk                String   @default("low") // low, medium, high
  affectedSystems     String[] @default([])
  metrics             Json     @default("[]")
  rollbackPlan        String
  successCriteria     String
  status              String   @default("draft") // draft, testing, validated, rejected
  // Computed once at creation from risk + affectedSystems — see
  // docs/LEARNING_CORE_PLAN.md "Approval levels". 1 = auto-deploy,
  // 2 = approval after successful testing, 3 = always requires approval.
  approvalLevel       Int      @default(2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  experiments Experiment[]

  @@map("learning_hypotheses")
}

model Experiment {
  id            String    @id @default(cuid())
  hypothesisId  String?
  type          String // prompt, retrieval, memory, planning, reasoning, tool_selection, workflow, graph_ranking, model_routing, skill, cost_optimization, ui_behavior
  version       String    @default("1.0.0")
  ownerId       String?
  status        String    @default("shadow") // shadow, running, completed, promoted, discarded
  // Inherited from parent Hypothesis at creation; defaults to 2 (requires
  // approval) when created without one. See docs/LEARNING_CORE_PLAN.md.
  approvalLevel Int       @default(2)
  metrics       Json      @default("{}")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  hypothesis Hypothesis? @relation(fields: [hypothesisId], references: [id], onDelete: SetNull)
  benchmarks Benchmark[]

  @@index([hypothesisId])
  @@map("learning_experiments")
}

model Benchmark {
  id            String   @id @default(cuid())
  name          String
  metric        String
  value         Float
  baselineValue Float?
  experimentId  String?
  createdAt     DateTime @default(now())

  experiment Experiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@index([experimentId])
  @@map("learning_benchmarks")
}

// Trust is runtime-derived, not identity — deliberately kept off Agent
// itself (same reasoning as Agent's own doc comment: volatile metrics live
// in dedicated tables, not the identity record).
model AgentTrustScore {
  id                   String   @id @default(cuid())
  agentId              String   @unique
  score                Float    @default(50)
  accuracy             Float    @default(0)
  rollbackCount        Int      @default(0)
  hallucinations       Int      @default(0)
  unsafeEvents         Int      @default(0)
  failedExperiments    Int      @default(0)
  overrides            Int      @default(0)
  approvedImprovements Int      @default(0)
  benchmarkWins        Int      @default(0)
  updatedAt            DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("learning_agent_trust_scores")
}

model TrustEvent {
  id        String   @id @default(cuid())
  agentId   String
  delta     Float
  reason    String
  category  String
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("learning_trust_events")
}

model Skill {
  id            String   @id @default(cuid())
  name          String
  description   String
  dependencies  String[] @default([])
  tests         Json     @default("[]")
  benchmarks    Json     @default("[]")
  ownerId       String?
  version       String   @default("0.1.0")
  approvalLevel Int      @default(1) // 1 = auto-deploy, 2 = approval after testing, 3 = always requires approval
  status        String   @default("proposed") // proposed, testing, approved, installed, deprecated
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("learning_skills")
}

model EvolutionEvent {
  id          String   @id @default(cuid())
  title       String
  stage       String // created, testing, shadow, approved, production, rollback, superseded
  relatedType String?
  relatedId   String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([relatedType, relatedId])
  @@map("learning_evolution_events")
}

model FeatureFlag {
  id                    String   @id @default(cuid())
  key                   String   @unique
  enabled               Boolean  @default(false)
  scope                 String   @default("global") // global, agent, workspace, user, organization
  scopeId               String?
  rolloutPercentage     Int      @default(0)
  autoRollbackThreshold Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("learning_feature_flags")
}
