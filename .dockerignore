# Dependencies
node_modules/
.pnpm-store/
pnpm-lock.yaml
pnpm-workspace.yaml

# Build output
.next/
out/
dist/
build/
backups/

# Runtime state that exists only on a deployed host. runtime-agents/home holds the
# Claude Code / Codex CLI credentials (.credentials.json, auth.json) and is bind-mounted
# at run time; `COPY . .` in the builder and worker stages used to bake it into image
# layers. runtime-projects/ is agent working data.
runtime-agents/
runtime-projects/
**/.credentials.json
**/.claude.json
**/auth.json
*.dump
*.rdb

# Environment files — never bake secrets into the image
.env
.env.local
.env.*.local

# Version control
.git/
.gitignore

# Dev tooling
.claude/
.superpowers/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
.next-start.*.log

# Local visual QA fixture is not part of the production application.
src/app/visual-qa/

# TypeScript build info
*.tsbuildinfo

# Docker files themselves (not needed in context)
Dockerfile
docker-compose.yml
.dockerignore
