# Same LiveKit project as the Next.js app — the worker joins rooms the app
# minted tokens for.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# STT/TTS are provider-agnostic (see providers.py) — these select the
# implementation at startup. Currently registered: STT_PROVIDER=deepgram,
# TTS_PROVIDER=cartesia (both also the defaults if unset).
# STT_PROVIDER="deepgram"
# TTS_PROVIDER="cartesia"

# Deepgram Flux STT.
DEEPGRAM_API_KEY=""

# Cartesia Sonic 3.5 TTS.
CARTESIA_API_KEY=""

# Base URL of the Next.js app's chat endpoint, e.g. https://your-deployment/api/chat
SENTINEL_API_BASE_URL=""

# Must match the Next.js app's VOICE_WORKER_SECRET — this is what authenticates
# the worker's /api/chat calls as a resolved Sentinel user.
VOICE_WORKER_SECRET=""
