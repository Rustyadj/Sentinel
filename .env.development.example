# Copy to .env.development (gitignored) and set your local scratch-database
# password. Never commit .env.development.
# Throwaway Phase 1 development database (container: sentinel-dev-postgres).
# NOT production. Production is sentinel-os-postgres-1 on the Docker network,
# reachable only as postgres:5432 and never migrated by development tasks.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:55432/sentinel_dev
