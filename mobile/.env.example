# Pre-fills the "Server URL" field on the login screen. It's still editable
# in the app, so this is a convenience default, not a hard requirement.
# Point it at whatever's running your Sentinel backend:
#   - iOS Simulator: http://localhost:3000
#   - Android Emulator: http://10.0.2.2:3000  (localhost inside the emulator refers to the emulator itself)
#   - Physical device: http://<your-machine's-LAN-IP>:3000
#   - Deployed instance: https://sentinel.example.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
