# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension required
DATABASE_URL="postgresql://hermes:hermes@localhost:5432/hermesos"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Public URL of your deployment (no trailing slash)
AUTH_URL="https://srv1427612.hstgr.cloud"

# ── Neural Engine (Phase E) ───────────────────────────────────────────────────
# Shared secret for POST /api/learning/scheduler/run-degradation-sweep (and the
# legacy /api/neural/degradation/sweep alias) — a manual/operational trigger
# for ops and testing. Production scheduling runs through the real BullMQ
# worker below (docker compose service `learning-worker`), not this endpoint
# alone. Leave unset to disable the manual endpoint (it fails closed).
NEURAL_SWEEP_SECRET=""

# ── Learning Core queue/worker (see src/lib/learning/queue.ts) ────────────────
# Requires REDIS_URL below. Run the worker with `npm run worker:learning` or
# `docker compose up learning-worker`. Registers real recurring jobs
# (degradation sweep nightly, knowledge-gap analysis weekly, experience
# replay nightly per category) — see scheduleRecurringJobs()'s own comment
# for exactly which spec-named jobs are NOT yet wired (nothing here silently
# no-ops a named job; unimplemented ones are just not registered).
LEARNING_WORKER_CONCURRENCY="2"

# ── OAuth Providers (optional) ────────────────────────────────────────────────
# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Traefik / TLS ─────────────────────────────────────────────────────────────
# Your public domain — used for Traefik routing rules and TLS cert
DOMAIN=srv1427612.hstgr.cloud

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=rustyadj@gmail.com

# ── VPS Control Plane ─────────────────────────────────────────────────────────
# Mark Sentinel as the primary UI served at the VPS root
SENTINEL_DEFAULT_UI=true

# Control-plane roles are database-backed workspace Owner/Admin assignments.

# Agent HTTP endpoints. Compose uses host.docker.internal as the explicit host
# boundary, but a service bound strictly to host loopback still needs a narrow
# bridge/reverse proxy before the app container can reach it; verify on the VPS.
HERMES_ENDPOINT=http://host.docker.internal:4860
HERMES_CLINT_ENDPOINT=http://host.docker.internal:4861
OPENCLAW_ENDPOINT=http://host.docker.internal:3001

# Explicit container names; agent identity is never assumed to equal a
# Docker container name by the runtime adapter layer.
HERMES_LISA_CONTAINER=hermes-lisa
HERMES_CLINT_CONTAINER=hermes-clint
OPENCLAW_CONTAINER=openclaw

# Native fallback dashboards stay visible until host acceptance passes.
HERMES_LISA_NATIVE_URL=/legacy/hermes
HERMES_CLINT_NATIVE_URL=
OPENCLAW_NATIVE_URL=/legacy/openclaw

# Coding runtime execution. These binaries and provider auth must exist in the
# same constrained execution environment as the Sentinel app process. Merely
# finding ~/.local/bin/claude or codex on the VPS host is not sufficient when
# Sentinel runs inside Docker; see docs/reviews/RUNTIME_ADAPTER_LAYER.md.
AGENT_PROJECT_ROOT=/opt/sentinel-os/projects
# Host directory bind-mounted read/write at AGENT_PROJECT_ROOT by Compose.
# Point this only at the repositories coding runtimes are allowed to modify.
AGENT_PROJECT_ROOT_HOST=./runtime-projects
CLAUDE_CODE_EXECUTABLE=claude
CLAUDE_CODE_PROJECT_ROOT=/opt/sentinel-os/projects
CLAUDE_CODE_WORKSPACE_ID=
CODEX_EXECUTABLE=codex
CODEX_PROJECT_ROOT=/opt/sentinel-os/projects
CODEX_WORKSPACE_ID=

# Model overrides (optional)
# HERMES_LISA_MODEL=claude-sonnet-4-6
# HERMES_CLINT_MODEL=claude-sonnet-4-6
# OPENCLAW_MODEL=claude-opus-4-8

# Directory for per-agent config files (CLAUDE.md, config.json, etc.)
AGENT_CONFIG_DIR=/opt/sentinel-os/agents

# Directory for agent log files (file-based fallback when docker logs unavailable)
AGENT_LOG_DIR=/opt/sentinel-os/logs

# ── AI Providers (per-user — set in Settings → API Keys, NOT here) ────────────
# Provider credentials are server-only in production.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
ALLOW_BROWSER_PROVIDER_KEYS=false
NEXT_PUBLIC_VOICE_PROVIDER=browser_stt

# ── LiveKit Voice Gateway (SentinelVoiceGateway) ──────────────────────────────
# Real-time voice: LiveKit WebRTC + Silero VAD/turn detector + Deepgram Flux
# STT + Cartesia Sonic 3.5 TTS, with transcripts routed through Sentinel's own
# /api/chat (never a separate "voice brain" — see docs/voice/LIVEKIT_ARCHITECTURE.md).
# Set NEXT_PUBLIC_VOICE_PROVIDER=livekit to select this provider in the client.
# Leave unset to disable — /api/voice/token fails closed (503) without these.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Shared secret the separately-deployed LiveKit Agents worker (worker/) uses to
# call POST /api/chat on this app's behalf, as the resolved conversation user
# (via `serviceUserId` + `Authorization: Bearer <value>`), so a voice turn gets
# the exact same tools/memory/persistence as a typed turn. Leave unset to
# disable this path entirely (falls back to normal session auth only).
VOICE_WORKER_SECRET=""
